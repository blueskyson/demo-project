# 官方映像 icr.io/db2_community/db2 的環境變數
# 必須接受授權才會啟動
LICENSE=accept
# instance 名稱 (同時也是容器內的 OS 使用者)
DB2INSTANCE=db2inst1
# db2inst1 的密碼 (僅供練習)
DB2INST1_PASSWORD=Passw0rd
# 留空：不自動建庫，Lab 02 會手動 CREATE DATABASE
DBNAME=
BLU=false
ENABLE_ORACLE_COMPATIBILITY=false
UPDATEAVAIL=NO
TO_CREATE_SAMPLEDB=false
REPODB=false
IS_OSXFS=false
PERSISTENT_HOME=true
HADR_ENABLED=false
