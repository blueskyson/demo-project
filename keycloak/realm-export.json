{
  "realm": "esg-award",
  "displayName": "ESG Award",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginTheme": "keycloak",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Can manage every award event, proposal, member and file"
      },
      {
        "name": "normal_user",
        "description": "Can edit proposals they lead while the award event is open"
      }
    ]
  },
  "clients": [
    {
      "clientId": "esg-award-frontend",
      "name": "ESG Award Frontend (SPA)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      }
    }
  ],
  "users": [
    {
      "username": "esg-admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "ESG",
      "lastName": "Admin",
      "email": "esg-admin@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin",
        "offline_access",
        "uma_authorization"
      ]
    },
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Chen",
      "email": "alice@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "alice123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "normal_user",
        "offline_access",
        "uma_authorization"
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Wang",
      "email": "bob@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "bob123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "normal_user",
        "offline_access",
        "uma_authorization"
      ]
    }
  ]
}
